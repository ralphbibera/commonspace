{
  "name": "@commonspace/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@commonspace/adapters": "workspace:*",
    "@commonspace/shared": "workspace:*",
    "express": "^5.1.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  }
}
