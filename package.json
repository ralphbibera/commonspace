{
  "name": "commonspace",
  "version": "0.1.0",
  "description": "A local-first workspace for projects, channels, direct messages, and coding agents.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @commonspace/server --filter @commonspace/ui --parallel --stream run dev",
    "dev:server": "pnpm --filter @commonspace/server dev",
    "dev:ui": "pnpm --filter @commonspace/ui dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @commonspace/shared build && pnpm --filter @commonspace/adapters build && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:adapters": "COMMONSPACE_LIVE_ADAPTERS=1 vitest run tests/live-agent-adapters.spec.ts --testTimeout=240000",
    "verify:adapters:codex": "COMMONSPACE_LIVE_ADAPTERS=1 vitest run tests/live-agent-adapters.spec.ts -t 'Codex sessions' --testTimeout=240000",
    "verify:adapters:claude": "COMMONSPACE_LIVE_ADAPTERS=1 vitest run tests/live-agent-adapters.spec.ts -t 'Claude Code sessions' --testTimeout=240000",
    "verify:live": "pnpm build && node scripts/verify-live.mjs",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "start": "pnpm --filter @commonspace/server start"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.11",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "eslint": "9.39.1",
    "jsdom": "27.4.0",
    "playwright": "1.61.1",
    "prettier": "3.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5"
}
