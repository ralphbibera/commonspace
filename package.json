{
	"name": "commonspace-workspace",
	"version": "0.0.1",
	"description": "A local-first workspace for projects, channels, direct messages, and coding agents.",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @commonspace/server --filter @commonspace/ui --parallel --stream run dev",
		"dev:server": "pnpm --filter @commonspace/server dev",
		"dev:ui": "pnpm --filter @commonspace/ui dev",
		"storybook": "pnpm --filter @commonspace/ui storybook",
		"build:storybook": "pnpm --filter @commonspace/ui build-storybook",
		"build-storybook": "pnpm build:storybook",
		"build": "pnpm -r --if-present build",
		"typecheck": "pnpm --filter @commonspace/shared build && pnpm -r --if-present typecheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:storybook": "pnpm --filter @commonspace/ui test-storybook --run",
		"test:storybook:smoke": "pnpm --filter @commonspace/ui test-storybook:smoke",
		"test:storybook:watch": "pnpm --filter @commonspace/ui test-storybook",
		"test:visual": "playwright test --config playwright.visual.config.ts",
		"e2e:server": "node server/node_modules/tsx/dist/cli.mjs scripts/e2e-server.mjs",
		"test:e2e": "pnpm build && pnpm test:e2e:built",
		"test:e2e:built": "playwright test --config tests/e2e/playwright.config.ts",
		"test:e2e:headed": "pnpm build && playwright test --config tests/e2e/playwright.config.ts --headed",
		"check:ui:smoke": "pnpm --filter @commonspace/ui typecheck && pnpm test:storybook:smoke",
		"check:ui": "pnpm --filter @commonspace/ui typecheck && pnpm test:storybook && pnpm --filter @commonspace/ui build",
		"check:fast": "pnpm biome:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:storybook:smoke",
		"verify:acp": "COMMONSPACE_LIVE_ACP=1 vitest run tests/live-acp.spec.ts --testTimeout=240000",
		"verify:acp:hermes": "COMMONSPACE_LIVE_ACP=1 vitest run tests/live-acp.spec.ts -t 'Hermes sessions' --testTimeout=240000",
		"verify:acp:codex": "COMMONSPACE_LIVE_ACP=1 vitest run tests/live-acp.spec.ts -t 'Codex sessions' --testTimeout=240000",
		"verify:acp:mcp": "COMMONSPACE_LIVE_ACP_MCP=1 vitest run tests/live-acp-mcp.spec.ts --testTimeout=240000",
		"verify:acp:mcp:hermes": "COMMONSPACE_LIVE_ACP_MCP=1 vitest run tests/live-acp-mcp.spec.ts -t 'real Hermes' --testTimeout=240000",
		"verify:acp:mcp:codex": "COMMONSPACE_LIVE_ACP_MCP=1 vitest run tests/live-acp-mcp.spec.ts -t 'real Codex' --testTimeout=240000",
		"verify:live": "pnpm build && node scripts/verify-live.mjs",
		"verify:live:built": "node scripts/verify-live.mjs",
		"verify:notifications": "COMMONSPACE_LIVE_NOTIFICATIONS=1 vitest run tests/live-desktop-notifications.spec.ts --testTimeout=30000",
		"verify:service": "node scripts/verify-service.mjs",
		"build:npm": "pnpm build && pnpm package:npm",
		"package:npm": "node scripts/package-npm.mjs",
		"verify:npm-package": "node scripts/verify-npm-package.mjs",
		"benchmark:workspace": "node --expose-gc server/node_modules/tsx/dist/cli.mjs scripts/benchmark-workspace.ts",
		"service:install": "node scripts/commonspace-service.mjs install --source .",
		"service:update": "node scripts/commonspace-service.mjs update",
		"service:start": "node scripts/commonspace-service.mjs start",
		"service:stop": "node scripts/commonspace-service.mjs stop",
		"service:status": "node scripts/commonspace-service.mjs status",
		"service:rollback": "node scripts/commonspace-service.mjs rollback",
		"lint": "eslint .",
		"biome:check": "biome check .",
		"biome:lint": "biome lint .",
		"biome:format": "biome format .",
		"check": "pnpm biome:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:storybook && pnpm build && pnpm build:storybook",
		"start": "pnpm --filter @commonspace/server start",
		"verify:acp:claude-code": "COMMONSPACE_LIVE_ACP=1 vitest run tests/live-acp.spec.ts -t 'Claude Code sessions' --testTimeout=240000",
		"verify:acp:mcp:claude-code": "COMMONSPACE_LIVE_ACP_MCP=1 vitest run tests/live-acp-mcp.spec.ts -t 'real Claude Code' --testTimeout=240000",
		"verify:adapter:claude-code": "vitest run tests/native-agent-integration.spec.ts -t 'Claude Code'",
		"verify:adapter:gemini": "vitest run tests/native-agent-integration.spec.ts -t 'Gemini CLI'",
		"verify:adapter:opencode": "vitest run tests/native-agent-integration.spec.ts -t 'OpenCode'",
		"verify:adapters": "vitest run tests/native-agent-integration.spec.ts",
		"verify:routing-quality": "COMMONSPACE_ROUTING_EVAL=1 vitest run tests/routing-quality.eval.spec.ts --testTimeout=60000"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@eslint/js": "9.39.1",
		"@modelcontextprotocol/sdk": "1.30.0",
		"@playwright/test": "1.61.1",
		"@testing-library/react": "16.3.0",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "22.19.11",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"biome-anti-slop": "^0.1.0",
		"eslint": "9.39.1",
		"eslint-plugin-storybook": "^10.6.0",
		"jsdom": "27.4.0",
		"playwright": "1.61.1",
		"prettier": "3.8.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"typescript": "5.9.3",
		"typescript-eslint": "8.56.1",
		"vitest": "4.1.8",
		"zod": "^4.4.3"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.34.5"
}
