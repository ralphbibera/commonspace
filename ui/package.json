{
	"name": "@commonspace/ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"clean": "rm -rf dist",
		"storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
		"build-storybook": "storybook build --disable-telemetry",
		"test-storybook": "COMMONSPACE_STORYBOOK_TEST=1 STORYBOOK_DISABLE_TELEMETRY=1 vitest --config vitest.storybook.config.ts",
		"test-storybook:smoke": "COMMONSPACE_STORYBOOK_TEST=1 COMMONSPACE_STORYBOOK_TAG=smoke STORYBOOK_DISABLE_TELEMETRY=1 vitest --config vitest.storybook.config.ts --run"
	},
	"dependencies": {
		"@base-ui/react": "1.7.0",
		"@commonspace/shared": "workspace:*",
		"@tanstack/react-router": "1.170.32",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.39.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"streamdown": "2.6.0",
		"tailwind-merge": "3.6.0",
		"tw-animate-css": "1.4.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "5.3.1",
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-mcp": "^10.6.0",
		"@storybook/addon-vitest": "^10.6.0",
		"@storybook/react-vite": "^10.6.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "^5.1.4",
		"@vitest/browser-playwright": "4.1.8",
		"@vitest/coverage-v8": "4.1.8",
		"shadcn": "4.20.0",
		"storybook": "^10.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "5.9.3",
		"vite": "^8.0.0"
	}
}
